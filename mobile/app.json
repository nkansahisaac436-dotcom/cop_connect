{
  "expo": {
    "name": "COP Connect",
    "slug": "cop-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2545"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
